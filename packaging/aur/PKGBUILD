pkgname=split-keyboard-git
_pkgname=split-keyboard
pkgver=r1.ab31c62
pkgrel=1
pkgdesc="Split on-screen keyboard for wlroots-based Wayland compositors in tablet mode"
arch=('x86_64')
url="https://github.com/blendonl/split-keyboard"
license=('MIT')
depends=('glibc' 'libgcc' 'wayland')
makedepends=('cargo' 'git')
options=('!debug')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+https://github.com/blendonl/split-keyboard.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  )
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$_pkgname"
  install -Dm755 "target/release/$_pkgname" "$pkgdir/usr/bin/$_pkgname"
  install -Dm644 config.toml -t "$pkgdir/usr/share/$_pkgname/"
  install -Dm644 layers/*.toml -t "$pkgdir/usr/share/$_pkgname/layers/"
  install -Dm644 README.md LAYER_CONFIG.md -t "$pkgdir/usr/share/doc/$_pkgname/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
